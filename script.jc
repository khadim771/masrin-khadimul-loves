      );

    }
  );



/* =====================================
   MAYBE BUTTON
===================================== */

const noButton =
  document.getElementById(
    "noButton"
  );


noButton.addEventListener(
  "mouseenter",
  () => {

    noButton.style.transform =
      `translate(
        ${(Math.random() - .5) * 180}px,
        ${(Math.random() - .5) * 110}px
      )`;

  }
);


noButton.addEventListener(
  "click",
  () => {

    showToast(
      "This button is too shy 😌❤️"
    );

  }
);



/* =====================================
   FIREWORKS
===================================== */

let fireworksParticles = [];


function fireworks() {

  for (
    let k = 0;
    k < 8;
    k++
  ) {

    const x =
      Math.random() *
      window.innerWidth;

    const y =
      100 +
      Math.random() *
      window.innerHeight *
      .65;


    for (
      let i = 0;
      i < 65;
      i++
    ) {

      const angle =
        Math.random() *
        Math.PI *
        2;

      const velocity =
        2 +
        Math.random() * 7;


      fireworksParticles.push({

        x: x,

        y: y,

        vx:
          Math.cos(angle) *
          velocity,

        vy:
          Math.sin(angle) *
          velocity,

        life: 1

      });

    }

  }

}


function drawFireworks() {

  fxContext.clearRect(
    0,
    0,
    window.innerWidth,
    window.innerHeight
  );


  fireworksParticles
    .forEach(
      particle => {

        particle.x +=
          particle.vx;

        particle.y +=
          particle.vy;

        particle.vy +=
          .05;

        particle.life -=
          .012;


        fxContext.globalAlpha =
          Math.max(
            0,
            particle.life
          );


        const colors = [
          "#ff6b98",
          "#ffd77d",
          "#ffffff",
          "#ffabc7"
        ];


        fxContext.fillStyle =
          colors[
            Math.floor(
              Math.random() *
              colors.length
            )
          ];


        fxContext.beginPath();

        fxContext.arc(
          particle.x,
          particle.y,
          2.5,
          0,
          Math.PI * 2
        );

        fxContext.fill();

      }
    );


  fireworksParticles =
    fireworksParticles.filter(
      particle =>
        particle.life > 0
    );


  requestAnimationFrame(
    drawFireworks
  );

}


drawFireworks();



/* =====================================
   YES ❤️
===================================== */

function yesLove() {

  document
    .getElementById(
      "finalMessage"
    )
    .classList.add(
      "show"
    );


  fireworks();


  for (
    let i = 0;
    i < 110;
    i++
  ) {

    setTimeout(
      fireworks,
      i * 18
    );

  }


  showToast(
    "Forever mode unlocked 💖"
  );

}



/* =====================================
   TOAST
===================================== */

function showToast(message) {

  const toast =
    document.getElementById(
      "toast"
    );

  toast.textContent =
    message;

  toast.classList.add(
    "show"
  );


  setTimeout(
    () => {

      toast.classList.remove(
        "show"
      );

    },
    2300
  );

}



/* =====================================
   FULLSCREEN
===================================== */

function openFullscreen() {

  if (
    document.documentElement
      .requestFullscreen
  ) {

    document.documentElement
      .requestFullscreen();

  }

}
