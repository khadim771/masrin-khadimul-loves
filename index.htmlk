<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Masrin ❤️ Khadimul</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
    radial-gradient(circle at top,#3b1021 0%,#14070d 35%,#050207 100%);
    color:white;
    font-family:Montserrat,sans-serif;
    overflow-x:hidden;
}

body:before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:20;
    background:
    radial-gradient(circle at center,
    transparent 45%,
    rgba(0,0,0,.55) 100%);
}

section{
    min-height:100vh;
    padding:90px 20px;
    display:grid;
    place-items:center;
    position:relative;
}

.container{
    width:min(1100px,100%);
    margin:auto;
}

.serif{
    font-family:"Cormorant Garamond",serif;
}

.script{
    font-family:"Great Vibes",cursive;
}

.kicker{
    text-transform:uppercase;
    letter-spacing:5px;
    font-size:.7rem;
    color:#f7d58b;
    margin-bottom:20px;
}

.hero{
    text-align:center;
    overflow:hidden;
}

.glow{
    position:absolute;
    width:600px;
    height:600px;
    border-radius:50%;
    background:
    radial-gradient(circle,
    rgba(255,70,120,.25),
    transparent 70%);
    animation:pulse 4s infinite;
}

@keyframes pulse{
    50%{
        transform:scale(1.15);
        opacity:.6;
    }
}

.heart{
    font-size:60px;
    color:#ff6389;
    animation:heartbeat 1.5s infinite;
    filter:drop-shadow(0 0 30px #ff5078);
}

@keyframes heartbeat{

    0%,100%{
        transform:scale(1);
    }

    15%{
        transform:scale(1.2);
    }

    30%{
        transform:scale(1);
    }

    45%{
        transform:scale(1.15);
    }
}

.names{
    font-size:clamp(3.5rem,10vw,7rem);
    line-height:.95;
    margin:20px 0;
}

.names span{
    color:#ff6f91;
}

.subtitle{
    max-width:700px;
    margin:auto;
    color:#e8dce0;
    line-height:1.9;
}

.btn{
    margin-top:30px;
    padding:15px 25px;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.2);
    background:rgba(255,255,255,.08);
    color:white;
    cursor:pointer;
    backdrop-filter:blur(10px);
    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px);
    background:rgba(255,80,120,.2);
    box-shadow:0 0 30px rgba(255,80,120,.3);
}

.title{
    text-align:center;
    font-size:clamp(3rem,7vw,5rem);
    margin-bottom:20px;
}

.intro{
    max-width:700px;
    text-align:center;
    margin:0 auto 50px;
    line-height:1.9;
    color:#d9cbd0;
}

.photo{
    width:min(500px,92vw);
    display:block;
    margin:auto;
    border-radius:25px;
    border:2px solid rgba(255,190,210,.25);
    box-shadow:
    0 30px 90px rgba(0,0,0,.7),
    0 0 50px rgba(255,80,120,.12);
    animation:photoFloat 5s ease-in-out infinite;
}

@keyframes photoFloat{

    50%{
        transform:translateY(-10px);
    }
}

.caption{
    text-align:center;
    margin-top:30px;
    font-family:"Cormorant Garamond";
    font-size:1.4rem;
    line-height:1.8;
}

.counter{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    max-width:800px;
    margin:auto;
}

.counterBox{
    padding:25px 10px;
    text-align:center;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.1);
    border-radius:20px;
    backdrop-filter:blur(12px);
}

.counterBox strong{
    display:block;
    font-family:"Cormorant Garamond";
    font-size:3rem;
    color:#ffd6df;
}

.counterBox span{
    font-size:.65rem;
    letter-spacing:2px;
    color:#bca9b0;
}

.timeline{
    max-width:800px;
    margin:auto;
}

.event{
    margin:25px 0;
    padding:30px;
    border-radius:25px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.1);
    backdrop-filter:blur(12px);
}

.event h3{
    font-family:"Cormorant Garamond";
    color:#ffd6df;
    font-size:1.8rem;
    margin-bottom:10px;
}

.event p{
    color:#d7c9cf;
    line-height:1.8;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    padding:30px;
    min-height:190px;
    border-radius:25px;
    background:
    linear-gradient(
    145deg,
    rgba(255,255,255,.09),
    rgba(255,255,255,.03)
    );
    border:1px solid rgba(255,255,255,.1);
    transition:.4s;
}

.card:hover{
    transform:translateY(-10px);
    border-color:#ff6f91;
    box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.card .emoji{
    font-size:35px;
    margin-bottom:15px;
}

.card h3{
    font-family:"Cormorant Garamond";
    font-size:1.7rem;
    margin-bottom:10px;
}

.card p{
    color:#d8cbd0;
    line-height:1.7;
}

.letter{
    max-width:800px;
    margin:auto;
    padding:50px;
    border-radius:30px;
    background:
    linear-gradient(
    145deg,
    rgba(255,255,255,.09),
    rgba(255,255,255,.03)
    );
    border:1px solid rgba(255,210,140,.2);
}

.letter p{
    font-family:"Cormorant Garamond";
    font-size:1.35rem;
    line-height:1.9;
    margin:15px 0;
}

.signature{
    text-align:right;
    font-family:"Great Vibes";
    font-size:3rem;
    color:#ff6f91;
    margin-top:30px;
}

.question{
    text-align:center;
}

.question h2{
    font-family:"Cormorant Garamond";
    font-size:clamp(3.5rem,9vw,7rem);
    line-height:1;
}

.question h2 span{
    color:#ff6f91;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.yes{
    background:linear-gradient(
    135deg,
    #ff5f87,
    #c91f55
    );
    border:none;
    box-shadow:0 0 40px rgba(255,90,130,.3);
}

#message{
    display:none;
    margin-top:40px;
    text-align:center;
}

#message.show{
    display:block;
    animation:appear .8s ease;
}

@keyframes appear{

    from{
        opacity:0;
        transform:scale(.7);
    }

    to{
        opacity:1;
        transform:scale(1);
    }
}

footer{
    text-align:center;
    padding:50px 20px;
    color:#a9949d;
}

.petal{
    position:fixed;
    top:-30px;
    z-index:50;
    pointer-events:none;
    animation:fall linear forwards;
}

@keyframes fall{

    to{
        transform:
        translateY(110vh)
        rotate(720deg);
        opacity:0;
    }

}

@media(max-width:700px){

    .counter{
        grid-template-columns:repeat(2,1fr);
    }

    .cards{
        grid-template-columns:1fr;
    }

    .letter{
        padding:30px 20px;
    }

    .names{
        font-size:3.7rem;
    }

}

</style>
</head>

<body>

<!-- HERO -->

<section class="hero">

<div class="glow"></div>

<div class="container">

<div class="heart">♥</div>

<div class="kicker">
A little universe made for two
</div>

<h1 class="names serif">
Masrin <span>♥</span> Khadimul
</h1>

<p class="subtitle serif">

Some stories are written in books.

Ours is written in smiles,
little moments,
late night conversations,
and two hearts that found each other.

</p>

<button class="btn"
onclick="document.getElementById('story').scrollIntoView({behavior:'smooth'})">

Enter Our Story ❤️

</button>

</div>

</section>


<!-- PHOTO -->

<section id="story">

<div class="container">

<div class="kicker" style="text-align:center">
Our beautiful beginning
</div>

<h2 class="title serif">
One picture. A thousand feelings.
</h2>

<img
src="assets/couple.png"
class="photo"
alt="Masrin and Khadimul"
>

<p class="caption">

“If I could keep one moment in a frame forever,
I would choose this one.”

<br>

<span style="color:#f7d58b">
— Khadimul
</span>

</p>

</div>

</section>


<!-- DATE -->

<section>

<div class="container">

<div class="kicker" style="text-align:center">
Our special date
</div>

<h2 class="title serif">
02 • 06 • 2026
</h2>

<p class="intro">

A date is only a number until two hearts
give it a meaning.

For us, this date is a beautiful chapter
of our story.

</p>

<div class="counter">

<div class="counterBox">
<strong id="days">0</strong>
<span>Days</span>
</div>

<div class="counterBox">
<strong id="hours">0</strong>
<span>Hours</span>
</div>

<div class="counterBox">
<strong id="minutes">0</strong>
<span>Minutes</span>
</div>

<div class="counterBox">
<strong id="seconds">0</strong>
<span>Seconds</span>
</div>

</div>

</div>

</section>


<!-- STORY -->

<section>

<div class="container">

<div class="kicker" style="text-align:center">
Our story
</div>

<h2 class="title serif">
One heartbeat at a time
</h2>

<div class="timeline">

<div class="event">

<h3>
The Beginning ✨
</h3>

<p>

Somewhere between an ordinary day
and an unexpected smile,
our story started becoming
something extraordinary.

</p>

</div>


<div class="event">

<h3>
The Little Things 🌙
</h3>

<p>

It was never only the big moments.

It was the tiny conversations,
the laughs,
the care,
and the comfort of simply
having you.

</p>

</div>


<div class="event">

<h3>
02 June 2026 💍
</h3>

<p>

A date that deserves a place
in our little universe.

A reminder that beautiful
chapters can begin
at unexpected moments.

</p>

</div>


<div class="event">

<h3>
Today & Forever ❤️
</h3>

<p>

I don't just want beautiful memories.

I want a lifetime of them —
with you beside me.

</p>

</div>

</div>

</div>

</section>


<!-- REASONS -->

<section>

<div class="container">

<div class="kicker" style="text-align:center">
Why my heart chose you
</div>

<h2 class="title serif">
A few reasons I love you
</h2>

<p class="intro">
I could write a thousand reasons.
These are only a few.
</p>

<div class="cards">

<div class="card">
<div class="emoji">🌹</div>
<h3>Your Smile</h3>
<p>
Your smile can make an ordinary day
feel like a beautiful one.
</p>
</div>


<div class="card">
<div class="emoji">🫶</div>
<h3>Your Heart</h3>
<p>
The warmth and care you carry
makes me feel incredibly lucky.
</p>
</div>


<div class="card">
<div class="emoji">🌙</div>
<h3>Your Presence</h3>
<p>
Even silence feels comfortable
when it is shared with you.
</p>
</div>


<div class="card">
<div class="emoji">✨</div>
<h3>Your Little Things</h3>
<p>
The tiny things you do
are often my favorite things.
</p>
</div>


<div class="card">
<div class="emoji">🏡</div>
<h3>You Feel Like Home</h3>
<p>
Home became less about a place
and more about a person.
</p>
</div>


<div class="card">
<div class="emoji">♾️</div>
<h3>Simply You</h3>
<p>
After every reason,
the answer is still the same.

You.

</p>
</div>

</div>

</div>

</section>


<!-- LETTER -->

<section>

<div class="container">

<div class="kicker" style="text-align:center">
A letter from my heart
</div>

<h2 class="title serif">
For Masrin ❤️
</h2>

<div class="letter">

<p>
My love,
</p>

<p>

I don't know if a website can ever hold
everything I feel for you,
but I wanted to create this little world
where everything says one thing:

<strong>I LOVE YOU.</strong>

</p>

<p>

Thank you for the smiles,
the memories,
the quiet moments,
and all the little pieces of life
that become special simply
because you are there.

</p>

<p>

If life gives me a thousand more days,
I want to fill them with you.

More laughter.
More photos.
More silly moments.
More late-night conversations.

More memories.

</p>

<p>

And if I had to choose you again,
in every lifetime,
in every version of our story,

I would still choose you.

</p>

<div class="signature">

Forever yours,<br>
Khadimul ❤️

</div>

</div>

</div>

</section>


<!-- PROPOSAL -->

<section>

<div class="container">

<div class="question">

<div class="heart">
♥
</div>

<div class="kicker">
One last question
</div>

<h2>

Masrin...

<br>

<span>
Will you choose me
</span>

<br>

again & again?

</h2>

<p class="intro">

Not only for the perfect days.

For the silly days,
difficult days,
quiet days,
and every beautiful day
in between.

</p>

<div class="buttons">

<button
class="btn yes"
onclick="sayYes()">

YES, ALWAYS ❤️

</button>

<button
class="btn"
onclick="loveMessage()">

I LOVE YOU 💕

</button>

</div>

<div id="message">

<div class="letter">

<p style="text-align:center">

Then let's keep writing
this story.

</p>

<p style="text-align:center">

One day.

One laugh.

One memory.

One heartbeat at a time.

</p>

<div class="signature"
style="text-align:center">

Masrin ❤️ Khadimul

</div>

</div>

</div>

</div>

</div>

</section>


<footer>

Made with all my heart ❤️

<br><br>

Masrin & Khadimul

<br>

02 • 06 • 2026

</footer>


<script>

/* ANNIVERSARY COUNTER */

const anniversary =
new Date("2026-06-02T00:00:00");

function updateCounter(){

let diff =
Math.max(
0,
Date.now()-anniversary.getTime()
);

let days =
Math.floor(diff/86400000);

diff%=86400000;

let hours =
Math.floor(diff/3600000);

diff%=3600000;

let minutes =
Math.floor(diff/60000);

let seconds =
Math.floor((diff%60000)/1000);

document.getElementById("days")
.textContent=days.toLocaleString();

document.getElementById("hours")
.textContent=String(hours).padStart(2,"0");

document.getElementById("minutes")
.textContent=String(minutes).padStart(2,"0");

document.getElementById("seconds")
.textContent=String(seconds).padStart(2,"0");

}

updateCounter();

setInterval(updateCounter,1000);


/* ROSE PETALS */

function createPetal(){

const petal =
document.createElement("div");

petal.className="petal";

petal.innerHTML =
Math.random()>0.4
?"🌹"
:"❤️";

petal.style.left =
Math.random()*100+"vw";

petal.style.fontSize =
(12+Math.random()*20)+"px";

petal.style.animationDuration =
(5+Math.random()*7)+"s";

document.body.appendChild(petal);

setTimeout(()=>{
petal.remove();
},14000);

}

setInterval(createPetal,800);


/* YES BUTTON */

function sayYes(){

document
.getElementById("message")
.classList.add("show");

celebrate();

document
.getElementById("message")
.scrollIntoView({
behavior:"smooth"
});

}


/* LOVE BUTTON */

function loveMessage(){

alert(
"Masrin ❤️ Khadimul\n\n" +
"I love you more than words can explain. 💕"
);

}


/* CELEBRATION */

function celebrate(){

for(let i=0;i<100;i++){

const item =
document.createElement("div");

item.innerHTML =
Math.random()>0.4
?"❤️"
:"✨";

item.style.position="fixed";

item.style.left =
Math.random()*100+"vw";

item.style.top="-30px";

item.style.fontSize =
(12+Math.random()*20)+"px";

item.style.zIndex="100";

item.style.transition =
"transform 3s linear, opacity 3s";

document.body.appendChild(item);

setTimeout(()=>{

item.style.transform =
"translateY(110vh) rotate(700deg)";

item.style.opacity="0";

},50);

setTimeout(()=>{
item.remove();
},3500);

}

}

</script>

</body>
</html>
